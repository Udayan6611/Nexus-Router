# NEXUS ROUTER: server-side environment variables.
# Names and safe placeholders only. Copy to .env.local and fill in real values.
# Never commit .env.local. Never prefix these with NEXT_PUBLIC_.

# Logging verbosity: debug | info | warn | error (optional, default: info)
LOG_LEVEL=info

# Supabase (server-side only; never expose via NEXT_PUBLIC_* or to client code).
# Leave blank for local development without persistence.
# For live persistence in later modules, configure your project URL and service-role key:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder-min-20-chars

# Groq (server-side only; optional; simulator is used when not configured)
GROQ_API_KEY=your-groq-api-key-placeholder